# Non-custodial signing key. This wallet must be dedicated to this agent
# alone — never reused for a manual transfer outside it (README section 2,
# "one wallet, one job"). Never commit this file with a real key filled in.
WALLET_PRIVATE_KEY=0x...

# The Moramba `agents` row (payout agent) whose limits this instance
# enforces. Its registered payout wallet must match the address derived
# from WALLET_PRIVATE_KEY above, or every payment will be rejected.
MORAMBA_AGENT_ID=00000000-0000-0000-0000-000000000000
MORAMBA_API_BASE_URL=https://crypto.moramba.io

# Tempo testnet first (README section 3).
CHAIN_ID=42431
# Fill in your own Tempo testnet RPC endpoint — deliberately left blank
# rather than guessed.
RPC_URL=

DB_PATH=moramba_payment_agent.db

# Only needed for transfer_erc20 calls that don't pass their own
# token_contract_address.
DEFAULT_TOKEN_CONTRACT=
