# All values below are required — the setup wizard (`moramba-payment-agent-setup`
# / `python -m agent.setup`) collects every one of them for you, auto-detecting
# CHAIN_ID/RPC_URL/DEFAULT_TOKEN_CONTRACT from your agent's own Moramba
# config wherever it can. This file is only for hand-editing, e.g. if
# you're not using the wizard.

# Non-custodial signing key. This wallet must be dedicated to this agent
# alone — never reused for a manual transfer outside it (README section 2,
# "one wallet, one job"). Never commit this file with a real key filled in.
WALLET_PRIVATE_KEY=0x...

# The Moramba `agents` row (payout agent) whose limits this instance
# enforces. Its registered payout wallet must match the address derived
# from WALLET_PRIVATE_KEY above, or every payment will be rejected.
MORAMBA_AGENT_ID=00000000-0000-0000-0000-000000000000
MORAMBA_API_BASE_URL=https://crypto.moramba.io

# Bearer token for the /acp checkout endpoints (AP2 rail).
MORAMBA_ACP_API_KEY=

# Tempo testnet first (README section 3). The wizard derives both of these
# from your agent's own configured payout token when it can reach Moramba —
# fill them in by hand only if you're skipping the wizard.
CHAIN_ID=42431
RPC_URL=https://rpc.moderato.tempo.xyz

DB_PATH=moramba_payment_agent.db

# Token contract the transfer_erc20 rail uses when a caller doesn't pass
# its own token_contract_address. Auto-detected by the wizard from your
# agent's own configured payout token; left blank if that can't be
# determined (transfer_erc20 then just requires the caller to pass one).
DEFAULT_TOKEN_CONTRACT=
